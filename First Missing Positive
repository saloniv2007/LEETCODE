#include <stdlib.h>

void swap(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;
}

int firstMissingPositive(int* nums, int numsSize)
{
    int i = 0;

    while (i < numsSize)
    {
        int correct = nums[i] - 1;

        if (nums[i] > 0 &&
            nums[i] <= numsSize &&
            nums[i] != nums[correct])
        {
            swap(&nums[i], &nums[correct]);
        }
        else
        {
            i++;
        }
    }

    for (i = 0; i < numsSize; i++)
    {
        if (nums[i] != i + 1)
            return i + 1;
    }

    return numsSize + 1;
}
