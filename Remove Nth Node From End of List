struct ListNode* removeNthFromEnd(struct ListNode* head, int n) {
    struct ListNode dummy;
    dummy.next = head;

    struct ListNode *low = &dummy;
    struct ListNode *high= &dummy;

    for (int i =0;i<n;i++){
        high= high->next;
    }
        while(high->next != NULL){
            high = high->next;
            low = low->next;
        }
        low->next = low->next->next;
        return dummy.next;

}
